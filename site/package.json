{
  "name": "genvideoscope-browser",
  "version": "0.8.2",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:verify": "node scripts/verify-media.mjs",
    "case:generate": "python ../scripts/generate_growth_cases.py --force",
    "case:verify": "node scripts/case-media-verifier.mjs",
    "media:review": "node scripts/create-media-contact-sheet.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run media:prepare && npm run build && npm run media:verify && npm run case:verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "hash-wasm": "4.12.0",
    "idb": "8.0.3",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.2.0",
    "vitest": "4.1.0"
  },
  "type": "module"
}
